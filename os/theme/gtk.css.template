/* Newsk GTK theme hook — system accent for apps (EmDash, dialogs). */
/* Regenerated by newsk-accent; included from ~/.config/gtk-3.0/gtk.css */
@define-color newsk_accent __ACCENT__;
@define-color newsk_bg #0e0e0e;
@define-color newsk_fg #f5f5f5;

*:selected {
  background-color: @newsk_accent;
  color: @newsk_fg;
}
button.suggested-action {
  background-color: @newsk_accent;
  color: @newsk_fg;
}
a { color: @newsk_accent; }
check:checked, radio:checked {
  background-color: @newsk_accent;
  border-color: @newsk_accent;
}
entry:focus {
  border-color: @newsk_accent;
}
